{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "reviewers": [
    "tankdonut"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Collapse non-major dev-dependency updates into one PR; engine pins stay separate.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "excludePackageNames": [
        "@earendil-works/pi-ai",
        "@earendil-works/pi-coding-agent",
        "@earendil-works/pi-tui"
      ],
      "groupName": "devDependencies (non-major)"
    },
    {
      "matchDatasources": ["node-version"],
      "commitMessagePrefix": "chore(deps): "
    },
    {
      "matchPackageNames": [
        "@earendil-works/pi-ai",
        "@earendil-works/pi-coding-agent",
        "@earendil-works/pi-tui"
      ],
      "groupName": "engine",
      "commitMessagePrefix": "feat(deps): "
    },
    {
      "description": "Automerge non-major updates once CI passes and the approval workflow approves.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge development dependencies.",
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "description": "Engine pins stay manual: the release-workflow env-audit is required before merge.",
      "matchPackageNames": [
        "@earendil-works/pi-ai",
        "@earendil-works/pi-coding-agent",
        "@earendil-works/pi-tui"
      ],
      "automerge": false
    },
    {
      "description": "Major updates require manual review.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}

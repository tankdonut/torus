---
import Base from "./Base.astro";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	sourcePath: string;
	headings: Heading[];
}

const { title, sourcePath, headings } = Astro.props;
const base = import.meta.env.BASE_URL;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const sourceUrl = `https://github.com/tankdonut/torus/blob/main/${sourcePath}`;
---

<Base title={`${title} · torus`}>
	<div class="doc">
		<aside class="doc-toc">
			<p class="doc-toc-title">On this page</p>
			{toc.length > 0 && (
				<nav aria-label={`Table of contents for ${title}`}>
					<ul>
						{toc.map((heading) => (
							<li class={heading.depth === 3 ? "doc-toc-h3" : ""}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ul>
				</nav>
			)}
			<p class="doc-toc-source">
				<a href={sourceUrl}>View source on GitHub</a>
			</p>
		</aside>
		<article class="doc-article">
			<slot />
		</article>
	</div>
</Base>

<style>
	.doc {
		display: grid;
		grid-template-columns: minmax(14rem, 1fr) minmax(0, 3fr);
		gap: 3rem;
		align-items: start;
	}
	.doc-toc {
		position: sticky;
		top: 1.5rem;
		font-size: var(--text-small);
	}
	.doc-toc-title {
		margin: 0 0 0.5rem;
		color: var(--color-muted);
		font-family: "JetBrains Mono Variable", monospace;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.doc-toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.doc-toc li {
		margin: 0.25rem 0;
	}
	.doc-toc a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.doc-toc a:hover {
		border-bottom-color: currentColor;
	}
	.doc-toc-h3 {
		padding-left: 1rem;
	}
	.doc-toc-source {
		margin: 1.5rem 0 0;
	}
	.doc-toc-source a {
		font-size: var(--text-small);
	}
	.doc-article :is(h1, h2, h3, h4) {
		scroll-margin-top: 1.5rem;
	}
	@media (max-width: 55rem) {
		.doc {
			grid-template-columns: minmax(0, 1fr);
		}
		.doc-toc {
			position: static;
		}
	}
</style>

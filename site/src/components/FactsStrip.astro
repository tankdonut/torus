---
import pkg from "../../../package.json";
import repo from "../stats/repo.json";

/**
 * The machine strip under the hero, laid out in the statusline's own grammar:
 * one mono line, segments joined by middle dots, every number derived from
 * repo.json (scripts/repo-stats.mjs at build time) or package.json. The
 * staggered segment boot is the page's one signature moment; each segment
 * carries a transition-delay so the strip assembles left to right once, and
 * prefers-reduced-motion (handled by the shared reveal rules) skips it.
 */
const { extensions, tools, agents, skills } = repo.counts;
const segments = [
	{ value: String(extensions), label: "extensions" },
	{ value: String(tools), label: "tools" },
	{ value: String(agents), label: "agents" },
	{ value: String(skills), label: "skills" },
	{ value: `v${pkg.version}`, label: "release" },
];
---

<dl class="facts">
	{
		segments.map((segment, index) => (
			<div class="fact" data-reveal style={`transition-delay:${index * 70}ms`}>
				<dt class="visually-hidden">{segment.label}</dt>
				<dd>
					<span class="value">{segment.value}</span>
					<span class="label"> {segment.label}</span>
				</dd>
			</div>
		))
	}
</dl>

<style>
	.facts {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: calc(var(--spacing) * 2) 0;
		margin: 0;
		padding-block: calc(var(--spacing) * 3);
		border-block: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: var(--text-mono-label);
	}

	.fact + .fact::before {
		content: "·";
		color: var(--color-muted);
		margin: 0 calc(var(--spacing) * 4);
	}

	.fact dd {
		margin: 0;
		display: inline-flex;
		align-items: baseline;
		gap: 0.35em;
	}

	.value {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.label {
		color: var(--color-muted);
	}
</style>

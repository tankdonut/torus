---
interface Props {
	/** Prompt symbol printed before command lines. */
	prompt?: string;
	/** Title shown in the window chrome bar. */
	title?: string;
	/**
	 * Lines to render. A line starting with `<prompt> ` is a command line
	 * (prompt in accent color); anything else renders as output. Ignored when
	 * the default slot is provided.
	 */
	lines?: string[];
}

// biome-ignore lint/correctness/noUnusedVariables: rendered in the template below
const { prompt = "$", title, lines = [] } = Astro.props;
---

<div class="terminal">
	<div class="chrome" aria-hidden="true">
		<span class="dot"></span>
		<span class="dot"></span>
		<span class="dot"></span>
		{title ? <span class="chrome-title">{title}</span> : null}
	</div>
	<div class="body">
		{
			Astro.slots.has("default") ? (
				<slot />
			) : (
				lines.map((line) =>
					line.startsWith(`${prompt} `) ? (
						<div class="line">
							<span class="prompt">{prompt}</span>
							{line.slice(prompt.length + 1)}
						</div>
					) : (
						<div class="line output">{line === "" ? "\u00A0" : line}</div>
					),
				)
			)
		}
	</div>
</div>

<style>
	.terminal {
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		overflow: hidden;
	}

	.chrome {
		display: flex;
		align-items: center;
		gap: calc(var(--spacing) * 1.5);
		padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);
		border-bottom: 1px solid var(--color-border);
	}

	.dot {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
		background: var(--color-border);
	}

	.chrome-title {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--text-small);
		color: var(--color-muted);
	}

	.body {
		padding: calc(var(--spacing) * 4);
		font-family: var(--font-mono);
		font-size: var(--text-small);
		line-height: 1.7;
		overflow-x: auto;
	}

	.line {
		min-width: max-content;
	}

	.line:empty::before {
		content: "\u00a0";
	}

	.prompt {
		color: var(--color-accent);
		font-weight: 600;
		margin-right: calc(var(--spacing) * 2);
	}

	.output {
		color: var(--color-muted);
	}
</style>

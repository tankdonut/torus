---
import { cropLines, parseAnsiScreen } from "../lib/ansi.mjs";
import capturesMeta from "../tui/captures.json";

/**
 * Renders real TUI captures (site/src/tui/<variant>/<scene>.ans, produced by
 * scripts/capture-tui.mjs from live sessions) as colored HTML. Each figure
 * carries both variants — the same scenes captured under the engine's dark
 * and light themes — and CSS shows the one matching the site theme, so the
 * terminal objects follow the header toggle instead of staying dark.
 *
 * Framing discipline: square corners, no window chrome, no device frame. A
 * real capture does not need to be dressed as a fake terminal window; the
 * amber "live" mark reuses the TUI's running color.
 *
 * Line semantics are the terminal's own: lines never wrap; content wider
 * than the frame scrolls horizontally under a themed scrollbar, and the
 * head row carries the geometry from captures.json. A wrapped
 * capture would fake content the session never showed.
 */

interface Props {
	/** Scene file stem under src/tui/ (e.g. "fleet-list"). */
	scene: string;
	/** Pane-title label shown in the block's head row, e.g. "alt+t · fleet". */
	title?: string;
	/** Caption under the capture. */
	caption?: string;
	/** Keep only the last n lines after blank-trimming (sheets render bottom). */
	keepLast?: number;
	/** 0-based line window into the blank-trimmed capture; negatives count from the end. */
	from?: number;
	to?: number;
}

const { scene, title, caption, keepLast, from, to } = Astro.props;

const captures = import.meta.glob("../tui/*/*.ans", { query: "?raw", import: "default", eager: true });

// Terminal ground/ink per capture variant: SGR runs without explicit colors
// (and inverse-video fallbacks) resolve against these, matching the theme
// the pane was captured under. Keep in sync with the --term-* values in
// global.css.
const VARIANT_DEFAULTS = {
	dark: { fg: "#cfd6dd", bg: "#101216" },
	light: { fg: "#3b3f41", bg: "#f6f7f9" },
} as const;
type Variant = keyof typeof VARIANT_DEFAULTS;

function variantLines(scene: string, variant: Variant) {
	const raw = captures[`../tui/${variant}/${scene}.ans`];
	if (typeof raw !== "string") {
		throw new Error(`TUI capture "${variant}/${scene}" is missing; run npm run -w site capture`);
	}
	return { raw, lines: cropLines(parseAnsiScreen(raw), { keepLast, from, to }) };
}

const variants = {
	dark: variantLines(scene, "dark"),
	light: variantLines(scene, "light"),
} as const;
const [captureWidth, captureHeight] = capturesMeta.geometry;
const fullHeight = parseAnsiScreen(variants.dark.raw).length;
const geometry = `${captureWidth}×${captureHeight}`;

const spanStyle = (run: Record<string, unknown>, defaults: { fg: string; bg: string }): string => {
	const parts: string[] = [];
	const fg = run.inverse ? (run.bg ?? "#101216") : run.fg;
	const bg = run.inverse ? (run.fg ?? defaults.fg) : run.bg;
	if (fg !== undefined) parts.push(`color:${fg}`);
	if (bg !== undefined) parts.push(`background:${bg}`);
	if (run.bold) parts.push("font-weight:700");
	if (run.italic) parts.push("font-style:italic");
	if (run.dim) parts.push("opacity:.6");
	if (run.underline) parts.push("text-decoration:underline");
	return parts.join(";");
};

// set:html on <pre> renders this markup directly, so run text is escaped
// first: captures legitimately contain <torus:start ...> and friends.
const escapeHtml = (text: string) =>
	text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");

const rendered = (variant: Variant) =>
	variants[variant].lines
		.map((line) =>
			line
				.map((run) => {
					const style = spanStyle(run, VARIANT_DEFAULTS[variant]);
					return style === ""
						? escapeHtml(run.text)
						: `<span style="${style}">${escapeHtml(run.text)}</span>`;
				})
				.join("")
				.replace(/\s+$/, ""),
		)
		.join("\n");
---

<figure class="tui">
	<div class="frame">
		<div class="head" aria-hidden="true">
			{title ? <span class="head-title">{title}</span> : <span class="head-title">{scene}</span>}
			<span class="geometry">{geometry}{variants.dark.lines.length !== fullHeight ? " · crop" : ""}</span>
			<span class="live"><span class="pulse"></span>live capture</span>
		</div>
		<pre class="capture capture-dark" set:html={rendered("dark")} />
		<pre class="capture capture-light" set:html={rendered("light")} />
	</div>
	{caption ? <figcaption>{caption}</figcaption> : null}
</figure>

<style>
	.tui {
		margin: calc(var(--spacing) * 6) 0;
	}

	.frame {
		border: 1px solid var(--term-border-strong);
		overflow: hidden;
		background: var(--term-bg);
		/* One uniform width for every capture, like a stack of same-sized
		 * screenshots; narrower content letterboxes against the capture ground. */
		width: 100%;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
		padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
		border-bottom: 1px solid var(--term-border);
		background: var(--term-panel-raised);
	}

	/* Segments never break mid-phrase; the row wraps as whole segments on
	 * narrow screens instead. */
	.head-title,
	.geometry {
		font-family: var(--font-mono);
		font-size: var(--text-mono-label);
		color: var(--term-muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	/* Amber is the TUI's running-agent color; the live mark spends it on the
	 * one thing that is actually running, at each theme's in-terminal value. */
	.live {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--term-amber);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--term-amber);
	}

	pre {
		margin: 0;
		padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
		overflow-x: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--term-scrollbar) transparent;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--term-ink);
		tab-size: 8;
		/* Terminal semantics: lines never wrap (see the component docblock). */
		white-space: pre;
		background: transparent;
		border: none;
		width: max-content;
		max-width: 100%;
	}

	/* Chrome hides overlay scrollbars until touched; styling ::-webkit-scrollbar
	 * forces a classic, always-reserved track so the affordance exists at every
	 * width where the capture overflows. */
	pre::-webkit-scrollbar {
		height: 8px;
	}

	pre::-webkit-scrollbar-thumb {
		background: var(--term-scrollbar);
	}

	pre::-webkit-scrollbar-track {
		background: transparent;
	}

	/* Each figure ships both captures; CSS shows the one matching the site
	 * theme (dark default). display, not visibility: the hidden variant must
	 * not stack its own scrollbar under the visible one. */
	.capture-light {
		display: none;
	}

	:global(html[data-theme="light"]) .capture-light {
		display: block;
	}

	:global(html[data-theme="light"]) .capture-dark {
		display: none;
	}
</style>

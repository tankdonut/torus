---
/**
 * Shell command block with a copy button. Progressive enhancement only: the
 * command is fully readable with JS off; the button copies with
 * navigator.clipboard and flips to "copied" for a beat. Framed like the TUI
 * captures' head row so commands and captures share one grammar.
 */
interface Props {
	/** Command line(s) to render; the copy payload joins them with newlines. */
	lines: string[];
	/** Head-row label (e.g. "install"); defaults to "shell". */
	title?: string;
}
const { lines, title } = Astro.props;
// The copy payload drops the `$` shell-prompt decoration (if any) from each
// line: pasting a copied command must yield a runnable command, and the prompt
// is presentation only. Lines without a prompt prefix pass through untouched.
const payload = lines.map((line) => line.replace(/^\$\s+/, "")).join("\n");
---

<figure class="codeblock">
	<div class="frame">
		<div class="head">
			<span class="head-title">{title ?? "shell"}</span>
			<button class="copy" type="button" data-copy={payload}>copy</button>
		</div>
		<pre><code>{lines.map((line, index) => `${index > 0 ? "\n" : ""}${line}`)}</code></pre>
	</div>
</figure>

<style>
	.frame {
		border: 1px solid var(--color-border);
		overflow: hidden;
		background: var(--color-surface);
	}

	.head {
		display: flex;
		align-items: center;
		gap: calc(var(--spacing) * 3);
		padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
		border-bottom: 1px solid var(--color-border);
	}

	.head-title {
		font-family: var(--font-mono);
		font-size: var(--text-mono-label);
		color: var(--color-muted);
	}

	.copy {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		padding: 0.05rem 0.6rem;
		cursor: pointer;
	}

	.copy:hover {
		color: var(--color-text);
		border-color: var(--color-muted);
	}

	.copy[data-copied] {
		color: var(--color-green);
		border-color: color-mix(in srgb, var(--color-green) 45%, transparent);
	}

	.frame pre {
		margin: 0;
		padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
		font-family: var(--font-mono);
		font-size: var(--text-small);
		line-height: 1.6;
		background: var(--color-surface);
		border: none;
		/* The pre owns the full frame width (the copy chip lives in the
		 * head row), so a long token fits whole instead of splitting
		 * beside a flex sibling. Commands wrap rather than clip below
		 * desktop; break-word wraps at spaces first and splits a token
		 * only when it alone exceeds the line. */
		white-space: pre-wrap;
		overflow-wrap: break-word;
	}

	@media (width <= 40rem) {
		.frame pre {
			padding-inline: calc(var(--spacing) * 3);
			/* One step down keeps the longest install token (39ch) whole on a
			 * 390px screen instead of splitting it. */
			font-size: 0.8125rem;
		}
	}
</style>

<script>
	import { installCopyButtons } from "../lib/copy-buttons.mjs";
	installCopyButtons();
</script>

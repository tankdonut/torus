---
/**
 * Shell command block with a copy button. Progressive enhancement only: the
 * command is fully readable with JS off; the button copies with
 * navigator.clipboard and flips to "copied" for a beat. Framed like the TUI
 * captures' head row so commands and captures share one grammar.
 */
interface Props {
	/** Command line(s) to render; the copy payload joins them with newlines. */
	lines: string[];
	/** Head-row label (e.g. "install"); defaults to "shell". */
	title?: string;
}
const { lines, title } = Astro.props;
const payload = lines.join("\n");
---

<figure class="codeblock">
	<div class="frame">
		<div class="head" aria-hidden="true">
			<span class="head-title">{title ?? "shell"}</span>
		</div>
		<div class="rows">
			<pre><code>{lines.map((line, index) => `${index > 0 ? "\n" : ""}${line}`)}</code></pre>
			<button class="copy" type="button" data-copy={payload}>copy</button>
		</div>
	</div>
</figure>

<style>
	.frame {
		border: 1px solid var(--color-border);
		overflow: hidden;
		background: var(--color-surface);
	}

	.head {
		display: flex;
		align-items: center;
		padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
		border-bottom: 1px solid var(--color-border);
	}

	.head-title {
		font-family: var(--font-mono);
		font-size: var(--text-mono-label);
		color: var(--color-muted);
	}

	.rows {
		display: flex;
		align-items: baseline;
		gap: calc(var(--spacing) * 3);
	}

	.copy {
		flex: none;
		align-self: center;
		margin: calc(var(--spacing) * 2) calc(var(--spacing) * 3) calc(var(--spacing) * 2) auto;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		padding: 0.05rem 0.6rem;
		cursor: pointer;
	}

	.copy:hover {
		color: var(--color-text);
		border-color: var(--color-muted);
	}

	.copy[data-copied] {
		color: var(--color-green);
		border-color: color-mix(in srgb, var(--color-green) 45%, transparent);
	}

	.rows pre {
		margin: 0;
		flex: 1;
		min-width: 0;
		padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
		font-family: var(--font-mono);
		font-size: var(--text-small);
		line-height: 1.6;
		background: var(--color-surface);
		border: none;
		/* Commands wrap rather than clip: the hero install line is longer than
	 * its column at every breakpoint below desktop. */
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	@media (width <= 40rem) {
		.rows pre {
			padding-inline: calc(var(--spacing) * 3);
		}
	}
</style>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		button.addEventListener("click", () => {
			const text = button.dataset.copy ?? "";
			void navigator.clipboard?.writeText(text).then(() => {
				button.textContent = "copied";
				button.setAttribute("data-copied", "");
				setTimeout(() => {
					button.textContent = "copy";
					button.removeAttribute("data-copied");
				}, 1500);
			});
		});
	}
</script>

---
interface Props {
	/**
	 * Mono pane-title label rendered on the section's top rule, e.g.
	 * "delegation" or "install"; lowercase, no numbering (the sections are an
	 * argument, not a sequence).
	 */
	label: string;
	/** Anchor id; links scroll to the section with the rule in view. */
	id?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: rendered in the template below
const { label, id } = Astro.props;
---

<section class="section" id={id}>
	<h2 class="section-rule">
		<span class="section-label">{label}</span>
	</h2>
	<slot />
</section>

<style>
	.section-rule {
		display: flex;
		align-items: baseline;
		gap: calc(var(--spacing) * 3);
		margin-block: 0 calc(var(--spacing) * 6);
		border-top: 1px solid var(--color-border);
		padding-top: calc(var(--spacing) * 2);
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: var(--text-mono-label);
		font-weight: 500;
		color: var(--color-muted);
	}
</style>

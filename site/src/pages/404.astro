---
import Base from "../layouts/Base.astro";
import { joinBase } from "../lib/md-links.mjs";

const base = import.meta.env.BASE_URL;
const homeHref = joinBase(base, "/");
const docsHref = joinBase(base, "/docs/");
---

<Base title="Not found · torus">
	<div class="not-found">
		<p class="status">404</p>
		<h1>Page <em>not found</em></h1>
		<p>
			No page lives at this address. Start over from the landing page, or open
			the docs index to browse every rendered page.
		</p>
		<ul>
			<li>
				<a href={homeHref}>Landing page</a>
			</li>
			<li>
				<a href={docsHref}>Docs index</a>
			</li>
		</ul>
	</div>
</Base>

<style>
	.not-found {
		max-width: var(--measure);
	}
	.not-found .status {
		margin: 0 0 1.5rem;
		font-family: var(--font-mono);
		font-size: var(--text-small);
		color: var(--color-muted);
		letter-spacing: 0.1em;
	}
	.not-found p {
		max-width: var(--measure);
	}
	.not-found ul {
		display: flex;
		gap: calc(2 * var(--spacing));
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
	}
</style>

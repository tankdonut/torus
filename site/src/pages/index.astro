---
// This page owns its document instead of composing Base.astro: Base has no head
// slot, and a canonical <link> is only spec-valid (and only honored by crawlers)
// inside <head>. Everything else mirrors Base: chrome, inline font faces, reveal.
import interLatinExt from "@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2";
import monoLatinExt from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2";
import "../styles/global.css";
// The version pins the install commands; three levels up is the repo root's
// package.json, not site/package.json.
import pkg from "../../../package.json";
import CodeBlock from "../components/CodeBlock.astro";
import CommitGraph from "../components/CommitGraph.astro";
import FactsStrip from "../components/FactsStrip.astro";
import Faq from "../components/Faq.astro";
import GitHubMark from "../components/GitHubMark.astro";
import RepoCard from "../components/RepoCard.astro";
import Section from "../components/Section.astro";
import TuiCapture from "../components/TuiCapture.astro";
import repo from "../stats/repo.json";

const pitch =
	"A multi-agent coding harness on the pinned stock pi engine: a lead session that delegates to a roster of specialist agents, with every run visible live in the terminal.";
const version = pkg.version;
// The engine pin is read from package.json at build time; the landing never
// retypes a version string by hand. The pin lives in devDependencies because
// the launcher resolves the engine from the installed tree; a missing pin is
// a build error, not a "not pinned" string on the page.
const enginePin =
	pkg.devDependencies["@earendil-works/pi-coding-agent"] ??
	pkg.dependencies["@earendil-works/pi-coding-agent"];
if (typeof enginePin !== "string") {
	throw new Error("the engine pin is missing from package.json; the landing cannot show it");
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const docsHref = `${base}/docs/`;
const securityHref = `${base}/security/`;

const faq = [
	{
		q: "Is torus open source?",
		a: "Yes, under the MIT licence. Use it anywhere, including at work. The engine beneath it is a pinned dependency, not a fork: the harness and the engine are both readable, each in its own repository.",
	},
	{
		q: "Does it replace pi?",
		a: "No. pi is the engine; torus is the harness around it. The engine stays a stock pin in package.json, overridable per session with TORUS_PI_BIN, so engine releases are dependency bumps rather than merges.",
	},
	{
		q: "What do I need to run it?",
		a: "From source: Node 22.12 or newer. The binary and container installs carry their own runtime. tmux is optional; delegation panes appear only inside it.",
	},
	{
		q: "Which models does it use?",
		a: "Any provider the pi engine speaks. Each roster agent carries its own model chain with per-model concurrency caps, so cheap tiers run lookups while the primary chain handles builds. Bring your own keys.",
	},
	{
		q: "What does a delegated agent see?",
		a: "Its task text, its tools, and nothing of the lead conversation. Credentials are redacted in delegation logs, and memory writes pass through a read-only dreamer.",
	},
	{
		q: "Can I steer a running agent?",
		a: "Yes. alt+t opens the fleet browser over every live run: s steers one mid-run with a message, x stops it, and the transcripts are on screen the whole time.",
	},
	{
		q: "Can I leave a session running unattended?",
		a: "Opt in with --permission-mode auto. The automode decision model judges every shell command against your rules, risky commands stop for a dialog (or block when headless), and each decision lands in an audit log. The other guards stay on.",
	},
	{
		q: "How do I get my work back out?",
		a: "Plain git branches and commits. Teams, mailboxes, and state live under ~/.torus as ordinary files; nothing is stored in a proprietary format.",
	},
];

// Same inline @font-face block Base.astro ships: the woff2 files resolve and
// hash through vite, and the rules must sit in <head> for first paint.
const fontFaces = [
	`@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`,
	`@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatinExt}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD,U+02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}`,
	`@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${monoLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`,
	`@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${monoLatinExt}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD,U+02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}`,
].join("\n");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<meta name="theme-color" content="#f8f8f7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#101216" media="(prefers-color-scheme: dark)" />
		<style is:inline set:html={fontFaces} />
		<title>torus</title>
		<meta property="og:title" content="torus" />
		<meta property="og:description" content={pitch} />
		<link rel="canonical" href="https://tankdonut.github.io/torus/" />
	</head>
	<body>
		<header>
			<a class="wordmark" href={`${base}/`}>torus</a>
			<span class="seg">v{version}</span>
			<span class="seg sep" aria-hidden="true">·</span>
			<a class="seg" href={docsHref}>docs</a>
			<a class="gh" href="https://github.com/tankdonut/torus" aria-label="torus on GitHub">
				<GitHubMark />
			</a>
		</header>
		<main>
			<section class="hero">
				<div class="hero-grid">
					<h1 data-reveal>Delegate the work. Watch it happen.</h1>
					<div class="hero-side" data-reveal>
						<CodeBlock
							title="install"
							lines={[`$ pi install git:github.com/tankdonut/torus@v${version}`]}
						/>
						<p class="fine">
							MIT, free software including at work. Runs on any provider the pinned pi
							engine speaks; bring your own keys.
						</p>
						<p class="fine">
							<a href="https://github.com/tankdonut/torus">Source and releases</a>
							<span class="sep" aria-hidden="true">·</span>
							<a href={docsHref}>docs index</a>
						</p>
					</div>
				</div>
				<TuiCapture
					scene="fleet-detail"
					title="alt+t · fleet detail"
					caption="The fleet browser over a live run: the task the explorer was given, its transcript as it works, and the steer/stop footer under it. A capture of a real session, regenerated by npm run -w site capture."
				/>
				<p class="lede" data-reveal>
					torus is a multi-agent coding harness on the pinned stock
					<a href="https://github.com/earendil-works/pi"> pi engine</a>. A lead session hands
					work to a roster of specialist agents, and the terminal shows every one of them
					running: live transcripts, live tokens, mid-run steering.
				</p>
				<FactsStrip />
			</section>

			<Section label="delegation" id="delegation">
				<h2>Hand the work to a roster</h2>
				<p>
					Every specialist is one slash dispatch away: <code>/builder</code>,
					<code>/explorer</code>, <code>/librarian</code>, <code>/looker</code>,
					<code>/reviewer</code>, <code>/dreamer</code>. Sessions delegate into parallel
					fan-outs and sequential pipelines, and every agent also runs as a persona of the
					main session (<kbd>alt+p</kbd> cycles them).
				</p>
				<TuiCapture
					scene="roster"
					from={11}
					to={25}
					title="/roster"
					caption="The roster as the session sees it: agent descriptions, model chains, and per-provider concurrency caps."
				/>
			</Section>

			<Section label="intervene" id="visibility">
				<h2>Steer or stop any agent mid-run</h2>
				<p>
					Every running agent appears in the statusline fleet strip with live turns and
					tokens. <kbd>alt+t</kbd> opens the fleet browser over everything running: press
					<kbd>s</kbd> to steer an agent with a message, <kbd>x</kbd> to stop it.
				</p>
				<TuiCapture
					scene="statusline-fleet"
					keepLast={14}
					title="statusline · fleet strip"
					caption="A delegation in flight: the fleet strip carries the running agent; the statusline carries the session."
				/>
				<TuiCapture
					scene="fleet-list"
					from={0}
					to={5}
					title="fleet browser (alt+t)"
					caption="The fleet browser list over the same session. Every terminal block on this page is a capture of a real session, not a mockup."
				/>
			</Section>

			<Section label="teams" id="teams">
				<h2>Teams that outlive the session</h2>
				<p>
					Persistent teams take delegation further: named members hold mailboxes and a
					shared tasklist, survive restarts, and answer to the same fleet browser as any
					other run.
				</p>
				<TuiCapture
					scene="team"
					title="fleet browser · team"
					caption="A two-member team in the fleet browser: @handles with their agents, models, and live turns."
				/>
			</Section>

			<Section label="the engine" id="engine">
				<h2>A pin, not a fork</h2>
				<p>
					torus owns everything around the model calls; the engine beneath it is a stock,
					pinned dependency, overridable per session with <code>TORUS_PI_BIN</code>. Engine
					releases are dependency bumps, not merges.
				</p>
				<CodeBlock title="package.json" lines={[`"@earendil-works/pi-coding-agent": "${enginePin}"`]} />
				<dl>
					<dt>roster</dt>
					<dd>Specialist agents with their own model chains and tools.</dd>
					<dt>delegation</dt>
					<dd>Fan-outs, pipelines, and persistent teams with shared tasklists.</dd>
					<dt>terminal ui</dt>
					<dd>tmux panes, statusline, and the fleet browser.</dd>
					<dt>memory</dt>
					<dd>Git-backed notes injected into future sessions.</dd>
					<dt>automode</dt>
					<dd>Opt-in auto-approval for unattended runs: a decision model judges each shell command, and the audit log and other guards stay on.</dd>
				</dl>
			</Section>

			<Section label="in the open" id="open">
				<h2>The numbers are the repository's</h2>
				<p>
					torus is free software under the MIT licence, developed in public. The counts
					above and the graph below are derived from the repository at build time, not
					typed in by hand.
				</p>
				<RepoCard />
				<CommitGraph />
			</Section>

			<Section label="the rest" id="rest">
				<h2>Memory, skills, guards</h2>
				<dl>
					<dt>/reflect · /goal</dt>
					<dd>
						Notes are git-backed and injected into future sessions; /reflect distills a
						session into durable memory, /goal pins a standing objective.
					</dd>
					<dt>agent skills</dt>
					<dd>
						Skills follow the <a href="https://agentskills.io">Agent Skills</a> open
						standard, so the same skill runs in Claude Code and Codex unchanged; external
						skills drop into ~/.agents/skills/ with no configuration.
					</dd>
					<dt>guards</dt>
					<dd>
						Context-integrity guards watch what reaches the model, credentials are redacted
						in delegation logs, and memory writes pass a read-only dreamer. The threat
						model is on the <a href={securityHref}>security page</a>.
					</dd>
				</dl>
			</Section>

			<Section label="install" id="install">
				<h2>Four ways in</h2>
				<h3>As a pi package</h3>
				<p>
					With <a href="https://github.com/earendil-works/pi">pi</a> installed, one command
					loads the full extension pack, skills, and agent roster: no clone, no build.
					Launcher-only surfaces such as <code>torus serve</code> are not part of this mode.
				</p>
				<CodeBlock
					title="package"
					lines={[`$ pi install git:github.com/tankdonut/torus@v${version}`]}
				/>

				<h3>As a single binary</h3>
				<p>
					Download <code>torus-&lt;os&gt;-&lt;arch&gt;</code> from the
					<a href="https://github.com/tankdonut/torus/releases"> releases page</a>, make it
					executable, and run it; the first launch self-bootstraps the runtime.
				</p>
				<CodeBlock title="binary" lines={["$ chmod +x torus-<os>-<arch> && ./torus-<os>-<arch>"]} />

				<h3>In a container</h3>
				<p>The full toolchain, no host install:</p>
				<CodeBlock
					title="docker"
					lines={['$ docker run --rm -it -v "$PWD:/workspace" ghcr.io/tankdonut/torus']}
				/>

				<h3>From source</h3>
				<p>
					The contributor path. You need Node 22.12 or newer. tmux is optional, since
					delegation panes appear only inside tmux.
				</p>
				<CodeBlock
					title="source"
					lines={[
						"$ git clone https://github.com/tankdonut/torus.git && cd torus",
						"$ ./make.sh npmrc",
						"$ npm install",
						"$ ./runtime/bin/torus.mjs",
					]}
				/>

				<div class="cta">
					<p>
						Install it, open the terminal, meet the roster. If you do not like it,
						<code>pi remove</code> is one command too.
					</p>
					<p>
						<a href={docsHref}>Docs index</a>
						<span class="sep" aria-hidden="true">·</span>
						<a href={securityHref}>Security</a>
						<span class="sep" aria-hidden="true">·</span>
						<a href={`${base}/changelog/`}>Changelog</a>
					</p>
				</div>
			</Section>

			<Section label="questions" id="questions">
				<h2>The ones that decide it</h2>
				<p>Anything else is best asked where the code is: open an issue.</p>
				<Faq questions={faq} />
			</Section>
		</main>
		<footer>
			<a class="gh" href="https://github.com/tankdonut/torus">
				<GitHubMark />tankdonut/torus
			</a>
			<span class="sep" aria-hidden="true">·</span>
			<span>MIT</span>
			<span class="sep" aria-hidden="true">·</span>
			<a href={`${base}/changelog/`}>changelog</a>
		</footer>
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add("js-reveal");
				const targets = Array.from(root.querySelectorAll("[data-reveal]"));
				if (targets.length === 0) return;
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.add("is-visible");
							io.unobserve(entry.target);
						}
						if (root.querySelectorAll("[data-reveal]:not(.is-visible)").length === 0) io.disconnect();
					},
					{ rootMargin: "0px 0px -10% 0px" },
				);
				for (const el of targets) io.observe(el);
			})();
		</script>
	</body>
</html>

<style>
	header .seg {
		color: var(--color-muted);
	}

	header a.seg:hover {
		color: var(--color-accent);
	}

	header .gh {
		margin-left: auto;
		color: var(--color-muted);
	}

	header .gh:hover {
		color: var(--color-text);
	}

	.hero {
		padding-block: calc(var(--spacing) * 10) calc(var(--spacing) * 8);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(16rem, 2fr);
		gap: calc(var(--spacing) * 8);
		align-items: start;
	}

	h1 {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: var(--text-display);
		line-height: 1.04;
	}

	.lede {
		max-width: 66ch;
		font-size: 1.125rem;
		margin-block: calc(var(--spacing) * 6) calc(var(--spacing) * 8);
	}

	.fine {
		margin-top: calc(var(--spacing) * 3);
		font-size: var(--text-small);
		color: var(--color-muted);
	}

	.section h2 {
		max-width: 30ch;
		margin-block-end: calc(var(--spacing) * 5);
	}

	.section p {
		max-width: 66ch;
	}

	.section h3 {
		margin-block-start: calc(var(--spacing) * 10);
	}

	.section dl {
		margin-block-start: calc(var(--spacing) * 8);
		max-width: 66ch;
	}

	.cta {
		margin-block-start: calc(var(--spacing) * 12);
		padding-block-start: calc(var(--spacing) * 8);
		border-top: 1px solid var(--color-border);
	}

	@media (width <= 56rem) {
		.hero-grid {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}
</style>
